#if ENABLE(ADBLOCK)

header: "Shared/AdBlock/AdBlockState.h"
[CustomHeader] struct WebKit::AdBlockSubscriptionState {
    URL url;
    bool enabled;
    String title;
    double lastFetched;
};

header: "Shared/AdBlock/AdBlockState.h"
[CustomHeader] struct WebKit::AdBlockCatalogListState {
    String uuid;
    String title;
    String description;
    String supportURL;
    Vector<String> languages;
    bool hidden;
    bool enabled;
    bool defaultEnabled;
    double lastFetched;
};

header: "Shared/AdBlock/AdBlockState.h"
[CustomHeader] struct WebKit::AdBlockState {
    bool enabled;
    String customRules;
    Vector<String> allowlist;
    Vector<WebKit::AdBlockSubscriptionState> subscriptions;
    Vector<WebKit::AdBlockCatalogListState> catalogLists;
};

#endif
